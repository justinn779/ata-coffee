{
  "name": "ata-coffee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore,auth,storage --project demo-ata-coffee \"vitest run\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "functions:build": "esbuild functions/src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=functions/lib/index.js --external:firebase-admin --external:firebase-functions --log-level=warning",
    "emulators": "npm run functions:build && firebase emulators:start --only auth,firestore,functions,storage --project demo-ata-coffee",
    "seed": "tsx scripts/seed-emulator.ts --emulator"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@fontsource/noto-serif-tc": "^5.3.1",
    "@hookform/resolvers": "^5.9.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.77.0",
    "next": "15.5.6",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
