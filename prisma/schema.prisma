// ATA Coffee Management System — Prisma schema
// 慣例：
//  - 主鍵一律 UUID；人類可讀編號另以 *No / code 欄位 + unique 建立。
//  - 重量單位 g，Decimal(14,3)；金額 TWD，Decimal(14,2)；單位成本 Decimal(18,6)。
//  - 所有時間以 UTC 儲存（timestamptz），顯示時轉換為 Asia/Taipei。
//  - CHECK constraint 與帳本不可變 trigger 寫在 migration SQL（Prisma 無法宣告）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── 系統 / 身分 ─────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  sessions     Session[]
  auditLogs    AuditLog[]
  inventoryTxs InventoryTransaction[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)
  ip         String?
  userAgent  String?

  @@index([userId])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(6)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  summary    String?
  data       Json?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  prefix     String    @unique
  keyHash    String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  fileName   String
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  sha256     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
}

enum BrandAssetKind {
  LOGO
  MASCOT_ATI
  MASCOT_ATO
  PACKAGING
  OTHER
}

model BrandAsset {
  id         String         @id @default(uuid()) @db.Uuid
  kind       BrandAssetKind
  name       String
  storageKey String?
  mimeType   String?
  isOfficial Boolean        @default(false)
  note       String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
}

// ───────────────────────────── 主檔 ─────────────────────────────

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  contact   String?
  phone     String?
  email     String?
  country   String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  coffees   Coffee[]
  purchases GreenBeanPurchase[]
}

model Coffee {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  nameZh            String
  nameEn            String?
  brandName         String?
  country           String?
  region            String?
  farm              String?
  producer          String?
  variety           String?
  process           String?
  altitude          String?
  grade             String?
  supplierId        String?   @db.Uuid
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  originFlavorNotes String?
  imageKey          String?
  note              String?
  // 養豆與賞味預設（烘焙批次可覆寫）
  restStartDays     Int?
  peakFromDays      Int?
  peakToDays        Int?
  shelfLifeDays     Int?
  freshnessNote     String?
  archivedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  greenLots      GreenBeanLot[]
  inventoryItems InventoryItem[]
  products       Product[]
  brewRecipes    BrewRecipe[]
}

model GreenBeanPurchase {
  id           String    @id @default(uuid()) @db.Uuid
  purchaseNo   String    @unique
  supplierId   String?   @db.Uuid
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  purchaseDate DateTime  @db.Date
  invoiceNo    String?
  note         String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  lots GreenBeanLot[]
}

model GreenBeanLot {
  id               String             @id @default(uuid()) @db.Uuid
  lotCode          String             @unique
  purchaseId       String             @db.Uuid
  purchase         GreenBeanPurchase  @relation(fields: [purchaseId], references: [id])
  coffeeId         String             @db.Uuid
  coffee           Coffee             @relation(fields: [coffeeId], references: [id])
  purchasedWeightG Decimal            @db.Decimal(14, 3)
  unitPricePerKg   Decimal            @db.Decimal(14, 2)
  shippingCost     Decimal            @default(0) @db.Decimal(14, 2)
  otherCost        Decimal            @default(0) @db.Decimal(14, 2)
  receivedWeightG  Decimal            @db.Decimal(14, 3)
  // 入庫時固定之每克成本 = (採購重量kg × 單價 + 運費 + 其他) ÷ 實際入庫重量
  costPerG         Decimal            @db.Decimal(18, 6)
  moisturePercent  Decimal?           @db.Decimal(5, 2)
  densityGPerL     Decimal?           @db.Decimal(8, 2)
  waterActivity    Decimal?           @db.Decimal(4, 3)
  locationId       String?            @db.Uuid
  location         InventoryLocation? @relation(fields: [locationId], references: [id])
  note             String?
  receivedAt       DateTime           @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)

  roastBatches RoastBatch[]
  inventoryLot InventoryLot?
}

// ───────────────────────────── 烘焙 ─────────────────────────────

model RoasterProfile {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  brand            String
  model            String
  maxCapacityG     Decimal? @db.Decimal(10, 1)
  sensorConfig     Json?
  tempChannels     String[]
  heatControl      String?
  airflowControl   String?
  drumSpeedControl String?
  customFieldsSpec Json?
  note             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  batches RoastBatch[]
}

enum RoastStatus {
  POSTED
  VOIDED
}

model RoastBatch {
  id                  String         @id @default(uuid()) @db.Uuid
  batchNo             String         @unique
  greenLotId          String         @db.Uuid
  greenLot            GreenBeanLot   @relation(fields: [greenLotId], references: [id])
  roasterId           String         @db.Uuid
  roaster             RoasterProfile @relation(fields: [roasterId], references: [id])
  roastedAt           DateTime       @db.Timestamptz(6)
  status              RoastStatus    @default(POSTED)
  greenWeightG        Decimal        @db.Decimal(14, 3)
  roastedWeightG      Decimal        @db.Decimal(14, 3)
  weightLossPercent   Decimal        @db.Decimal(6, 3)
  chargeTempC         Decimal?       @db.Decimal(6, 1)
  turningPointSec     Int?
  turningPointTempC   Decimal?       @db.Decimal(6, 1)
  dryEndSec           Int?
  firstCrackStartSec  Int?
  firstCrackEndSec    Int?
  dropSec             Int?
  dropTempC           Decimal?       @db.Decimal(6, 1)
  totalTimeSec        Int?
  dryingPhaseSec      Int?
  maillardPhaseSec    Int?
  developmentPhaseSec Int?
  dtrPercent          Decimal?       @db.Decimal(6, 3)
  roastLevel          String?
  targetProfile       String?
  result              String?
  qualityRating       Int?
  note                String?
  customFields        Json?
  // 賞味覆寫（null = 使用咖啡豆預設）
  restStartDays       Int?
  peakFromDays        Int?
  peakToDays          Int?
  shelfLifeDays       Int?
  // 成本快照
  greenCostTotal      Decimal        @db.Decimal(14, 2)
  copiedFromId        String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  events          RoastEvent[]
  curves          RoastCurve[]
  cuppingSessions CuppingSession[]
  brewSessions    BrewSession[]
  inventoryLot    InventoryLot?
  costEntries     CostEntry[]
  experimentLinks ResearchExperimentLink[]

  @@index([roastedAt])
}

enum RoastEventType {
  CHARGE
  TURNING_POINT
  DRY_END
  FC_START
  FC_END
  SC_START
  DROP
  HEAT_CHANGE
  AIRFLOW_CHANGE
  DRUM_CHANGE
  NOTE
}

model RoastEvent {
  id           String         @id @default(uuid()) @db.Uuid
  roastBatchId String         @db.Uuid
  roastBatch   RoastBatch     @relation(fields: [roastBatchId], references: [id], onDelete: Cascade)
  timeSec      Int
  type         RoastEventType
  btC          Decimal?       @db.Decimal(6, 1)
  etC          Decimal?       @db.Decimal(6, 1)
  rorC         Decimal?       @db.Decimal(6, 2)
  heat         String?
  airflow      String?
  drumSpeed    String?
  note         String?

  @@index([roastBatchId, timeSec])
}

enum CurveSource {
  MANUAL
  CSV
  ARTISAN_ALOG
}

model RoastCurve {
  id               String      @id @default(uuid()) @db.Uuid
  roastBatchId     String      @db.Uuid
  roastBatch       RoastBatch  @relation(fields: [roastBatchId], references: [id], onDelete: Restrict)
  source           CurveSource
  originalFileName String?
  storageKey       String?
  fileSha256       String?
  columnMapping    Json?
  pointCount       Int
  rorComputed      Boolean     @default(false)
  isActive         Boolean     @default(true)
  importedAt       DateTime    @default(now()) @db.Timestamptz(6)

  points RoastCurvePoint[]

  // 重複匯入規則：同一批次同一檔案（SHA-256）拒絕重複匯入
  @@unique([roastBatchId, fileSha256])
}

model RoastCurvePoint {
  id        String     @id @default(uuid()) @db.Uuid
  curveId   String     @db.Uuid
  curve     RoastCurve @relation(fields: [curveId], references: [id], onDelete: Cascade)
  timeSec   Decimal    @db.Decimal(9, 2)
  btC       Decimal?   @db.Decimal(6, 1)
  etC       Decimal?   @db.Decimal(6, 1)
  rorC      Decimal?   @db.Decimal(7, 2)
  heat      Decimal?   @db.Decimal(7, 2)
  airflow   Decimal?   @db.Decimal(7, 2)
  drumSpeed Decimal?   @db.Decimal(7, 2)
  extra     Json?

  @@index([curveId, timeSec])
}

// ───────────────────────────── 杯測 ─────────────────────────────

model FlavorTag {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  category String?
  color    String?

  cuppings CuppingSessionTag[]
  brews    BrewSessionTag[]
}

model CuppingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  // 自訂評分系統：非 SCA 官方表單
  scaleMin    Decimal  @db.Decimal(5, 2)
  scaleMax    Decimal  @db.Decimal(5, 2)
  step        Decimal  @db.Decimal(4, 2)
  attributes  Json // [{ key, label }]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  sessions CuppingSession[]
}

model CuppingSession {
  id           String          @id @default(uuid()) @db.Uuid
  roastBatchId String          @db.Uuid
  roastBatch   RoastBatch      @relation(fields: [roastBatchId], references: [id])
  templateId   String          @db.Uuid
  template     CuppingTemplate @relation(fields: [templateId], references: [id])
  cuppedAt     DateTime        @db.Timestamptz(6)
  restDays     Int
  grindSetting String?
  doseG        Decimal?        @db.Decimal(8, 2)
  waterG       Decimal?        @db.Decimal(8, 2)
  waterTempC   Decimal?        @db.Decimal(5, 1)
  totalScore   Decimal?        @db.Decimal(6, 2)
  defects      String?
  description  String?
  evaluator    String?
  imageKey     String?
  consumedG    Decimal?        @db.Decimal(10, 3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  scores          CuppingScore[]
  tags            CuppingSessionTag[]
  experimentLinks ResearchExperimentLink[]

  @@index([cuppedAt])
}

model CuppingScore {
  id           String         @id @default(uuid()) @db.Uuid
  sessionId    String         @db.Uuid
  session      CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attributeKey String
  label        String
  score        Decimal        @db.Decimal(5, 2)

  @@unique([sessionId, attributeKey])
}

model CuppingSessionTag {
  sessionId   String         @db.Uuid
  session     CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  flavorTagId String         @db.Uuid
  flavorTag   FlavorTag      @relation(fields: [flavorTagId], references: [id])

  @@id([sessionId, flavorTagId])
}

// ───────────────────────────── 手沖 ─────────────────────────────

enum EquipmentType {
  GRINDER
  DRIPPER
  FILTER
  KETTLE
  SCALE
  OTHER
}

model Equipment {
  id        String        @id @default(uuid()) @db.Uuid
  type      EquipmentType
  name      String
  brand     String?
  model     String?
  note      String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  grinderSessions BrewSession[] @relation("grinder")
  dripperSessions BrewSession[] @relation("dripper")
  filterSessions  BrewSession[] @relation("filter")
  grinderRecipes  BrewRecipe[]  @relation("recipeGrinder")
  dripperRecipes  BrewRecipe[]  @relation("recipeDripper")
  filterRecipes   BrewRecipe[]  @relation("recipeFilter")

  @@unique([type, name])
}

model BrewRecipe {
  id            String     @id @default(uuid()) @db.Uuid
  rootId        String?    @db.Uuid // 版本鏈的第一版 id；第一版本身為 null
  version       Int        @default(1)
  name          String
  coffeeId      String?    @db.Uuid
  coffee        Coffee?    @relation(fields: [coffeeId], references: [id])
  isRecommended Boolean    @default(false)
  grinderId     String?    @db.Uuid
  grinder       Equipment? @relation("recipeGrinder", fields: [grinderId], references: [id])
  grindSetting  String?
  dripperId     String?    @db.Uuid
  dripper       Equipment? @relation("recipeDripper", fields: [dripperId], references: [id])
  filterId      String?    @db.Uuid
  filter        Equipment? @relation("recipeFilter", fields: [filterId], references: [id])
  doseG         Decimal    @db.Decimal(8, 2)
  waterG        Decimal    @db.Decimal(8, 2)
  waterTempC    Decimal?   @db.Decimal(5, 1)
  bloomWaterG   Decimal?   @db.Decimal(8, 2)
  bloomTimeSec  Int?
  totalTimeSec  Int?
  pourMethod    String?
  agitation     String?
  pourPlan      Json? // [{ stepNo, startSec, endSec, waterG }]
  note          String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)

  sessions    BrewSession[]
  brandSeries BrandSeries[]

  @@unique([rootId, version])
}

model BrewSession {
  id                String      @id @default(uuid()) @db.Uuid
  roastBatchId      String      @db.Uuid
  roastBatch        RoastBatch  @relation(fields: [roastBatchId], references: [id])
  recipeId          String?     @db.Uuid
  recipe            BrewRecipe? @relation(fields: [recipeId], references: [id])
  brewedAt          DateTime    @db.Timestamptz(6)
  restDays          Int
  grinderId         String?     @db.Uuid
  grinder           Equipment?  @relation("grinder", fields: [grinderId], references: [id])
  grindSetting      String?
  dripperId         String?     @db.Uuid
  dripper           Equipment?  @relation("dripper", fields: [dripperId], references: [id])
  filterId          String?     @db.Uuid
  filter            Equipment?  @relation("filter", fields: [filterId], references: [id])
  doseG             Decimal     @db.Decimal(8, 2)
  waterG            Decimal     @db.Decimal(8, 2)
  ratio             Decimal     @db.Decimal(6, 2) // 1:x
  waterTempC        Decimal?    @db.Decimal(5, 1)
  waterQuality      String?
  tdsPercent        Decimal?    @db.Decimal(5, 2)
  extractionPercent Decimal?    @db.Decimal(5, 2)
  totalTimeSec      Int?
  bloomTimeSec      Int?
  bloomWaterG       Decimal?    @db.Decimal(8, 2)
  pourMethod        String?
  flowRateGPerSec   Decimal?    @db.Decimal(5, 2)
  agitation         String?
  flavorNotes       String?
  rating            Decimal?    @db.Decimal(4, 1)
  note              String?
  isRecommended     Boolean     @default(false)
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)

  pourSteps       BrewPourStep[]
  tags            BrewSessionTag[]
  experimentLinks ResearchExperimentLink[]

  @@index([brewedAt])
}

model BrewPourStep {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @db.Uuid
  session     BrewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepNo      Int
  startSec    Int?
  endSec      Int?
  waterG      Decimal     @db.Decimal(8, 2)
  cumulativeG Decimal     @db.Decimal(8, 2)
  note        String?

  @@unique([sessionId, stepNo])
}

model BrewSessionTag {
  sessionId   String      @db.Uuid
  session     BrewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  flavorTagId String      @db.Uuid
  flavorTag   FlavorTag   @relation(fields: [flavorTagId], references: [id])

  @@id([sessionId, flavorTagId])
}

// ───────────────────────────── 研究 ─────────────────────────────

enum ResearchStatus {
  PLANNING
  RUNNING
  CONCLUDED
  ARCHIVED
}

model ResearchProject {
  id                   String         @id @default(uuid()) @db.Uuid
  code                 String         @unique
  name                 String
  hypothesis           String?
  objective            String?
  controlledVariables  String?
  independentVariables String?
  status               ResearchStatus @default(PLANNING)
  startDate            DateTime?      @db.Date
  result               String?
  conclusion           String?
  nextSteps            String?
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)

  experiments ResearchExperiment[]
}

model ResearchExperiment {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  project        ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int
  label          String
  isBaseline     Boolean         @default(false)
  experimentDate DateTime        @db.Date
  variableValues Json?
  observation    String? // 主觀觀察，與統計資料分開呈現
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)

  links ResearchExperimentLink[]

  @@unique([projectId, version])
}

model ResearchExperimentLink {
  id               String             @id @default(uuid()) @db.Uuid
  experimentId     String             @db.Uuid
  experiment       ResearchExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  roastBatchId     String?            @db.Uuid
  roastBatch       RoastBatch?        @relation(fields: [roastBatchId], references: [id])
  cuppingSessionId String?            @db.Uuid
  cuppingSession   CuppingSession?    @relation(fields: [cuppingSessionId], references: [id])
  brewSessionId    String?            @db.Uuid
  brewSession      BrewSession?       @relation(fields: [brewSessionId], references: [id])
}

// ───────────────────────────── 庫存（核心 Domain） ─────────────────────────────

enum InventoryKind {
  GREEN
  ROASTED
  FINISHED
  MATERIAL
}

enum InventoryUnit {
  G
  PCS
}

enum LotStatus {
  AVAILABLE
  QUARANTINE // 退貨待檢，不可售
  HOLD // 品質保留
  SCRAPPED
}

enum InventoryTxType {
  RECEIPT // 入庫
  ROAST_ISSUE // 烘焙領料
  ROAST_OUTPUT // 烘焙產出
  CUPPING_USE // 杯測耗用
  TASTING_USE // 試喝耗用
  SAMPLE_GIFT // 樣品贈送
  PACKAGING_ISSUE // 分裝耗用
  PACKAGING_LOSS // 分裝損耗
  PACKAGING_OUTPUT // 分裝產出
  MATERIAL_ISSUE // 包材耗用
  SCRAP // 報廢
  ADJUSTMENT // 盤點調整
  SHIPMENT_ISSUE // 出貨扣帳
  RETURN_QUARANTINE // 退貨待檢
  RETURN_RESTOCK_OUT // 退貨重新入庫（待檢區轉出）
  RETURN_RESTOCK_IN // 退貨重新入庫（可售區轉入）
  REVERSAL // 沖銷
}

model InventoryLocation {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  lots      InventoryLot[]
  greenLots GreenBeanLot[]
}

enum MaterialCategory {
  BAG
  LABEL
  DRIP_BAG
  BOX
  SEAL
  OTHER
}

model Material {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  name      String
  category  MaterialCategory
  spec      String?
  note      String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  inventoryItem InventoryItem?
  variantBoms   VariantMaterial[]
}

model InventoryItem {
  id                String          @id @default(uuid()) @db.Uuid
  kind              InventoryKind
  name              String
  unit              InventoryUnit
  coffeeId          String?         @db.Uuid
  coffee            Coffee?         @relation(fields: [coffeeId], references: [id])
  productVariantId  String?         @unique @db.Uuid
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id])
  materialId        String?         @unique @db.Uuid
  material          Material?       @relation(fields: [materialId], references: [id])
  lowStockThreshold Decimal?        @db.Decimal(14, 3)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  lots         InventoryLot[]
  transactions InventoryTransaction[]

  @@unique([kind, coffeeId])
}

model InventoryLot {
  id                String             @id @default(uuid()) @db.Uuid
  itemId            String             @db.Uuid
  item              InventoryItem      @relation(fields: [itemId], references: [id])
  lotCode           String             @unique
  status            LotStatus          @default(AVAILABLE)
  // onHand / reserved 為帳本衍生的快取欄位，只能由 InventoryService 在同一 DB 交易中與帳本一同更新；
  // 由 CHECK constraint 保證不為負、保留量不超過在庫量；並有對帳函式驗證 = SUM(帳本)。
  onHand            Decimal            @default(0) @db.Decimal(14, 3)
  reserved          Decimal            @default(0) @db.Decimal(14, 3)
  unitCost          Decimal            @db.Decimal(18, 6)
  locationId        String?            @db.Uuid
  location          InventoryLocation? @relation(fields: [locationId], references: [id])
  greenLotId        String?            @unique @db.Uuid
  greenLot          GreenBeanLot?      @relation(fields: [greenLotId], references: [id])
  roastBatchId      String?            @unique @db.Uuid
  roastBatch        RoastBatch?        @relation(fields: [roastBatchId], references: [id])
  packagingBatchId  String?            @unique @db.Uuid
  packagingBatch    PackagingBatch?    @relation(fields: [packagingBatchId], references: [id])
  returnSourceLotId String?            @db.Uuid
  returnSourceLot   InventoryLot?      @relation("returnSource", fields: [returnSourceLotId], references: [id])
  returnLots        InventoryLot[]     @relation("returnSource")
  producedAt        DateTime?          @db.Timestamptz(6)
  bestByDate        DateTime?          @db.Date
  expiryDate        DateTime?          @db.Date
  expirySource      String?
  note              String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  transactions             InventoryTransaction[]
  reservations             InventoryReservation[]
  allocations              OrderBatchAllocation[]
  consumptions             ProductionConsumption[]
  productionOrdersAsSource ProductionOrder[]

  @@index([itemId, status])
}

model InventoryTransaction {
  id             String                @id @default(uuid()) @db.Uuid // 唯一交易識別碼
  groupId        String                @db.Uuid // 同一業務操作的多筆分錄共用
  idempotencyKey String?               @unique
  itemId         String                @db.Uuid
  item           InventoryItem         @relation(fields: [itemId], references: [id])
  lotId          String                @db.Uuid
  lot            InventoryLot          @relation(fields: [lotId], references: [id])
  type           InventoryTxType
  quantity       Decimal               @db.Decimal(14, 3) // 正 = 增加；負 = 減少
  unit           InventoryUnit
  unitCost       Decimal               @db.Decimal(18, 6)
  balanceAfter   Decimal               @db.Decimal(14, 3)
  refType        String?
  refId          String?
  note           String?
  actorId        String?               @db.Uuid
  actor          User?                 @relation(fields: [actorId], references: [id])
  reversesId     String?               @unique @db.Uuid
  reverses       InventoryTransaction? @relation("reversal", fields: [reversesId], references: [id])
  reversedBy     InventoryTransaction? @relation("reversal")
  occurredAt     DateTime              @default(now()) @db.Timestamptz(6)

  @@index([lotId, occurredAt])
  @@index([itemId, occurredAt])
  @@index([refType, refId])
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ReservationPurpose {
  ORDER // 成品保留給訂單
  PRODUCTION // 熟豆保留給分裝生產單
}

model InventoryReservation {
  id                String             @id @default(uuid()) @db.Uuid
  lotId             String             @db.Uuid
  lot               InventoryLot       @relation(fields: [lotId], references: [id])
  quantity          Decimal            @db.Decimal(14, 3)
  purpose           ReservationPurpose
  status            ReservationStatus  @default(ACTIVE)
  salesOrderItemId  String?            @db.Uuid
  salesOrderItem    SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id])
  productionOrderId String?            @db.Uuid
  productionOrder   ProductionOrder?   @relation(fields: [productionOrderId], references: [id])
  note              String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  releasedAt        DateTime?          @db.Timestamptz(6)
  consumedAt        DateTime?          @db.Timestamptz(6)

  allocation OrderBatchAllocation?

  @@index([lotId, status])
}

// ───────────────────────────── 分裝生產 ─────────────────────────────

enum ProductionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum ProductionMode {
  PRE_PACK // 預先分裝
  MADE_TO_ORDER // 接單後分裝
}

enum QualityStatus {
  PASS
  HOLD
  FAIL
}

model ProductionOrder {
  id               String           @id @default(uuid()) @db.Uuid
  orderNo          String           @unique
  mode             ProductionMode
  status           ProductionStatus @default(PLANNED)
  sourceLotId      String           @db.Uuid // 熟豆批次（單一來源；配方豆擴充見 ProductionConsumption）
  sourceLot        InventoryLot     @relation(fields: [sourceLotId], references: [id])
  targetVariantId  String           @db.Uuid
  targetVariant    ProductVariant   @relation(fields: [targetVariantId], references: [id])
  plannedQty       Int
  actualQty        Int?
  fillWeightG      Decimal          @db.Decimal(10, 3)
  beansConsumedG   Decimal?         @db.Decimal(14, 3)
  lossG            Decimal?         @db.Decimal(14, 3)
  laborCost        Decimal?         @db.Decimal(14, 2)
  salesOrderItemId String?          @db.Uuid
  salesOrderItem   SalesOrderItem?  @relation(fields: [salesOrderItemId], references: [id])
  plannedDate      DateTime         @db.Date
  qualityStatus    QualityStatus    @default(PASS)
  note             String?
  completedAt      DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  version          Int              @default(0)

  consumptions   ProductionConsumption[]
  reservations   InventoryReservation[]
  packagingBatch PackagingBatch?
  costEntries    CostEntry[]
}

enum ConsumptionKind {
  BEANS
  LOSS
  MATERIAL
}

model ProductionConsumption {
  id                String          @id @default(uuid()) @db.Uuid
  productionOrderId String          @db.Uuid
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  lotId             String          @db.Uuid
  lot               InventoryLot    @relation(fields: [lotId], references: [id])
  kind              ConsumptionKind
  quantity          Decimal         @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(18, 6)
  totalCost         Decimal         @db.Decimal(14, 2)
}

model PackagingBatch {
  id                String          @id @default(uuid()) @db.Uuid
  batchNo           String          @unique
  productionOrderId String          @unique @db.Uuid
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  packagedAt        DateTime        @db.Timestamptz(6)
  quantity          Int
  totalCost         Decimal         @db.Decimal(14, 2)
  unitCost          Decimal         @db.Decimal(18, 6)
  bestByDate        DateTime?       @db.Date
  expiryDate        DateTime?       @db.Date
  expirySource      String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  outputLot    InventoryLot?
  traceability ProductTraceability?
}

// ───────────────────────────── 商品 ─────────────────────────────

enum ProductCategory {
  COFFEE_BEAN
  DRIP_BAG
  DRIP_BAG_SET
  GIFT_BOX
  MERCH
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockPolicy {
  STOCK_ONLY // 只賣現貨
  MADE_TO_ORDER // 無現貨時可接單後分裝
  NOT_TRACKED // 不追蹤庫存（周邊、服務）
}

enum SeriesCharacter {
  NONE
  ATI
  ATO
  BOTH
}

model BrandSeries {
  id                  String          @id @default(uuid()) @db.Uuid
  code                String          @unique
  name                String
  story               String?
  flavorNotes         String?
  character           SeriesCharacter @default(NONE)
  isLimited           Boolean         @default(false)
  launchDate          DateTime?       @db.Date
  imageKey            String?
  recommendedRecipeId String?         @db.Uuid
  recommendedRecipe   BrewRecipe?     @relation(fields: [recommendedRecipeId], references: [id])
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)

  products Product[]
}

model Product {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  name          String
  category      ProductCategory
  brandSeriesId String?         @db.Uuid
  brandSeries   BrandSeries?    @relation(fields: [brandSeriesId], references: [id])
  coffeeId      String?         @db.Uuid
  coffee        Coffee?         @relation(fields: [coffeeId], references: [id])
  description   String?
  flavorNotes   String?
  imageKey      String?
  status        ProductStatus   @default(DRAFT)
  isLimited     Boolean         @default(false)
  saleStartDate DateTime?       @db.Date
  saleEndDate   DateTime?       @db.Date
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  variants ProductVariant[]
}

model ProductVariant {
  id           String        @id @default(uuid()) @db.Uuid
  productId    String        @db.Uuid
  product      Product       @relation(fields: [productId], references: [id])
  sku          String        @unique
  name         String
  listPrice    Decimal       @db.Decimal(14, 2)
  salePrice    Decimal       @db.Decimal(14, 2)
  standardCost Decimal?      @db.Decimal(14, 2) // 估計成本；實際成本來自批次
  fillWeightG  Decimal?      @db.Decimal(10, 3) // 每包填充重量（豆/濾掛）
  isBundle     Boolean       @default(false)
  stockPolicy  StockPolicy   @default(STOCK_ONLY)
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  inventoryItem    InventoryItem?
  bundleComponents ProductBundleComponent[] @relation("bundle")
  usedInBundles    ProductBundleComponent[] @relation("component")
  materials        VariantMaterial[]
  orderItems       SalesOrderItem[]
  productionOrders ProductionOrder[]
  allocations      OrderBatchAllocation[]
}

model ProductBundleComponent {
  id                 String         @id @default(uuid()) @db.Uuid
  bundleVariantId    String         @db.Uuid
  bundleVariant      ProductVariant @relation("bundle", fields: [bundleVariantId], references: [id], onDelete: Cascade)
  componentVariantId String         @db.Uuid
  componentVariant   ProductVariant @relation("component", fields: [componentVariantId], references: [id])
  quantity           Int

  @@unique([bundleVariantId, componentVariantId])
}

model VariantMaterial {
  id              String         @id @default(uuid()) @db.Uuid
  variantId       String         @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  materialId      String         @db.Uuid
  material        Material       @relation(fields: [materialId], references: [id])
  quantityPerUnit Decimal        @db.Decimal(10, 3)

  @@unique([variantId, materialId])
}

// ───────────────────────────── 訂單 ─────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  orders SalesOrder[]
}

enum PaymentStatus {
  UNPAID
  PENDING_CONFIRMATION
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING // 待處理
  AWAITING_PACKAGING // 待分裝
  READY_TO_SHIP // 可出貨
  SHIPPED // 已出貨
  COMPLETED // 已完成
  CANCELLED // 已取消
  RETURN_PROCESSING // 退貨處理中
}

enum OrderChannel {
  MANUAL
  WEB
  OTHER
}

enum TaxMode {
  INCLUSIVE // 售價含稅
  EXCLUSIVE // 售價未稅，另加稅
  NONE
}

model SalesOrder {
  id                String            @id @default(uuid()) @db.Uuid
  orderNo           String            @unique
  channel           OrderChannel      @default(MANUAL)
  externalRef       String?           @unique
  idempotencyKey    String?           @unique
  customerId        String?           @db.Uuid
  customer          Customer?         @relation(fields: [customerId], references: [id])
  customerName      String
  customerPhone     String?
  customerEmail     String?
  shippingAddress   String?
  orderedAt         DateTime          @default(now()) @db.Timestamptz(6)
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  taxMode           TaxMode
  taxRate           Decimal           @db.Decimal(6, 4)
  subtotal          Decimal           @db.Decimal(14, 2) // 商品小計（折扣後、稅前或含稅依 taxMode）
  discountTotal     Decimal           @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(14, 2)
  shippingFee       Decimal           @default(0) @db.Decimal(14, 2) // 向顧客收取之運費收入
  total             Decimal           @db.Decimal(14, 2)
  refundedTotal     Decimal           @default(0) @db.Decimal(14, 2)
  shippingMethod    String?
  note              String?
  paidAt            DateTime?         @db.Timestamptz(6)
  cancelledAt       DateTime?         @db.Timestamptz(6)
  completedAt       DateTime?         @db.Timestamptz(6)
  version           Int               @default(0)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  items       SalesOrderItem[]
  payments    PaymentRecord[]
  shipment    Shipment?
  returns     ReturnRecord[]
  costEntries CostEntry[]

  @@index([orderedAt])
  @@index([paymentStatus, fulfillmentStatus])
}

enum FulfillmentMode {
  STOCK
  MADE_TO_ORDER
  NOT_TRACKED
}

model SalesOrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  order             SalesOrder      @relation(fields: [orderId], references: [id])
  variantId         String          @db.Uuid
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  skuSnapshot       String
  nameSnapshot      String
  quantity          Int
  unitPriceSnapshot Decimal         @db.Decimal(14, 2)
  discount          Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  costSnapshot      Decimal?        @db.Decimal(14, 2) // 分配批次後寫入，之後不隨成本變動
  isBundle          Boolean         @default(false)
  fulfillmentMode   FulfillmentMode @default(STOCK)

  allocations      OrderBatchAllocation[]
  reservations     InventoryReservation[]
  productionOrders ProductionOrder[]
}

enum AllocationStatus {
  RESERVED
  SHIPPED
  RELEASED
}

model OrderBatchAllocation {
  id            String               @id @default(uuid()) @db.Uuid
  orderItemId   String               @db.Uuid
  orderItem     SalesOrderItem       @relation(fields: [orderItemId], references: [id])
  variantId     String               @db.Uuid // 實際出貨之成品 SKU（套組時為組件 SKU）
  variant       ProductVariant       @relation(fields: [variantId], references: [id])
  lotId         String               @db.Uuid
  lot           InventoryLot         @relation(fields: [lotId], references: [id])
  reservationId String               @unique @db.Uuid
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id])
  quantity      Decimal              @db.Decimal(14, 3)
  unitCost      Decimal              @db.Decimal(18, 6)
  status        AllocationStatus     @default(RESERVED)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)

  returnItems ReturnItem[]
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

model PaymentRecord {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @db.Uuid
  order          SalesOrder    @relation(fields: [orderId], references: [id])
  type           PaymentType
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 2)
  reference      String?
  idempotencyKey String?       @unique
  note           String?
  occurredAt     DateTime      @default(now()) @db.Timestamptz(6)
}

model Shipment {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @unique @db.Uuid
  order        SalesOrder @relation(fields: [orderId], references: [id])
  method       String?
  carrier      String?
  trackingNo   String?
  shippingCost Decimal    @default(0) @db.Decimal(14, 2) // 實際物流成本
  shippedAt    DateTime   @db.Timestamptz(6)
  note         String?
}

enum ReturnStatus {
  PENDING_INSPECTION
  COMPLETED
}

model ReturnRecord {
  id          String       @id @default(uuid()) @db.Uuid
  returnNo    String       @unique
  orderId     String       @db.Uuid
  order       SalesOrder   @relation(fields: [orderId], references: [id])
  status      ReturnStatus @default(PENDING_INSPECTION)
  reason      String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  completedAt DateTime?    @db.Timestamptz(6)

  items ReturnItem[]
}

enum ReturnDisposition {
  RESTOCK
  SCRAP
}

model ReturnItem {
  id              String               @id @default(uuid()) @db.Uuid
  returnId        String               @db.Uuid
  returnRecord    ReturnRecord         @relation(fields: [returnId], references: [id])
  allocationId    String               @db.Uuid
  allocation      OrderBatchAllocation @relation(fields: [allocationId], references: [id])
  quantity        Decimal              @db.Decimal(14, 3)
  quarantineLotId String               @db.Uuid
  disposition     ReturnDisposition?
  inspectedAt     DateTime?            @db.Timestamptz(6)
  note            String?
}

// ───────────────────────────── 成本 ─────────────────────────────

enum CostCategory {
  ROAST_ENERGY
  ROAST_LABOR
  PACKAGING_LABOR
  CONSUMABLES
  SHIPPING
  PLATFORM_FEE
  PAYMENT_FEE
  ORDER_OTHER
  OPERATING_EXPENSE
}

enum CostTarget {
  ROAST_BATCH
  PRODUCTION_ORDER
  SALES_ORDER
  PERIOD
}

model CostEntry {
  id                String              @id @default(uuid()) @db.Uuid
  category          CostCategory
  target            CostTarget
  amount            Decimal             @db.Decimal(14, 2)
  isEstimate        Boolean             @default(false)
  occurredOn        DateTime            @db.Date
  roastBatchId      String?             @db.Uuid
  roastBatch        RoastBatch?         @relation(fields: [roastBatchId], references: [id])
  productionOrderId String?             @db.Uuid
  productionOrder   ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  salesOrderId      String?             @db.Uuid
  salesOrder        SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  allocationRuleId  String?             @db.Uuid
  allocationRule    CostAllocationRule? @relation(fields: [allocationRuleId], references: [id])
  calcNote          String? // 保存計算方式（例：電費 0.8 度 × NT$4.5）
  note              String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  @@index([occurredOn])
}

model CostAllocationRule {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  category    CostCategory
  method      String // PER_BATCH | PER_KG_GREEN | PER_UNIT | PERCENT_OF_REVENUE
  rate        Decimal      @db.Decimal(14, 4)
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  entries CostEntry[]
}

// ───────────────────────────── 履歷 ─────────────────────────────

model ProductTraceability {
  id               String         @id @default(uuid()) @db.Uuid
  publicCode       String         @unique
  packagingBatchId String         @unique @db.Uuid
  packagingBatch   PackagingBatch @relation(fields: [packagingBatchId], references: [id])
  isPublished      Boolean        @default(false)
  recommendedBrew  String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
}

// 人類可讀編號序號（例：RB-20261121-01），以 INSERT ... ON CONFLICT 原子遞增
model DocumentSequence {
  key   String @id
  value Int
}
