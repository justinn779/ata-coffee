# ───────── ATA Coffee 環境變數範本 ─────────
# 複製為 .env（開發）與 .env.test（測試，DATABASE_URL 必須指向 ata_test）。
# 正式環境請在雲端平台的「環境變數」設定，不要提交到 Git。

# development | test | production（production 時 Seed 會拒絕執行）
APP_ENV=development

# PostgreSQL 連線字串（本機：npm run db:local 啟動的 PostgreSQL 17）
DATABASE_URL="postgresql://postgres:ata_local_dev@127.0.0.1:54329/ata_dev?schema=public"
# Supabase 範例（使用 Session Pooler / 直連，並加上 sslmode=require）：
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# 保留給未來簽章用途；請使用 32 字元以上隨機字串
SESSION_SECRET="change-me-to-a-long-random-string"

# 檔案儲存：目前僅實作 local
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# 產生 QR Code 公開網址時使用（例：https://admin.atacoffee.example）
PUBLIC_BASE_URL=

# 示範資料管理員密碼（僅 npm run db:seed 使用；未設定時為 seed.ts 內的本機示範密碼）
SEED_ADMIN_PASSWORD=

# 正式環境建立管理員（npm run admin:create）
ADMIN_EMAIL=
ADMIN_NAME=
