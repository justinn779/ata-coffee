rules_version = '2';
// ATA Coffee — Firestore 安全規則
//  * 所有寫入（庫存、訂單、成本、主檔、稽核）只能由 Cloud Functions（Admin SDK）執行；用戶端一律禁止寫入。
//  * 只有 admins/{uid} 名單中的登入者可以讀取後台資料。
//  * publicTraces（QR 商品履歷）只公開「已發布」的文件，且只能逐筆讀取，不能列出全部。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /publicTraces/{code} {
      allow get: if resource.data.published == true;
      allow list: if false;
      allow write: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
